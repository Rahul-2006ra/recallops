# ==============================================================================
# RecallOps Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file to version control.
# ==============================================================================

# Application Environment & Server Configuration
APP_ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Groq AI Model Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Hindsight Cloud Persistent Memory Configuration
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=your_hindsight_bank_id_here

# Local Database Configuration
DATABASE_URL=sqlite:///./recallops.db

# Firebase Authentication (Backend)
FIREBASE_PROJECT_ID=recallops-181ad
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json
TEST_AUTH_ENABLED=false

# Firebase Web Client Configuration (Frontend: copy to frontend/.env or root .env)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=recallops-181ad.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=recallops-181ad
VITE_FIREBASE_STORAGE_BUCKET=recallops-181ad.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=653299111774
VITE_FIREBASE_APP_ID=1:653299111774:web:66e09b53540e78e1c5e1cf
VITE_FIREBASE_MEASUREMENT_ID=G-QJ6LJSHPMP
