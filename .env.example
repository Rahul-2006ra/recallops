# ==============================================================================
# RecallOps Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file to version control.
# ==============================================================================

# Application Environment & Server Configuration
APP_ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Groq AI Model Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Hindsight Cloud Persistent Memory Configuration
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=your_hindsight_bank_id_here

# Local Database Configuration
DATABASE_URL=sqlite:///./recallops.db
